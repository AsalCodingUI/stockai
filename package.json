{
  "name": "stockai-web",
  "version": "0.1.0",
  "description": "StockAI Web Dashboard - Frontend build and test tooling",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node scripts/build.js",
    "build:css": "tailwindcss -i src/stockai/web/static/css/app.css -o src/stockai/web/static/css/dist/app.min.css --minify",
    "build:js": "node scripts/build-js.js",
    "watch:css": "tailwindcss -i src/stockai/web/static/css/app.css -o src/stockai/web/static/css/dist/app.min.css --watch",
    "test": "vitest --run",
    "test:watch": "vitest",
    "test:coverage": "vitest --run --coverage",
    "test:a11y": "vitest --run --reporter=verbose tests/unit/a11y",
    "lint": "eslint src/stockai/web/static/js --ext .js",
    "lint:fix": "eslint src/stockai/web/static/js --ext .js --fix"
  },
  "devDependencies": {
    "@axe-core/cli": "^4.10.2",
    "@testing-library/dom": "^10.4.0",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/user-event": "^14.5.2",
    "@vitest/coverage-v8": "^2.1.8",
    "axe-core": "^4.10.2",
    "esbuild": "^0.24.2",
    "eslint": "^9.17.0",
    "fast-check": "^3.23.2",
    "jsdom": "^25.0.1",
    "shadcn": "^4.8.3",
    "tailwindcss": "^3.4.17",
    "vitest": "^2.1.8"
  }
}
