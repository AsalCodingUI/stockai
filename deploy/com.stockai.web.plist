<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.stockai.web</string>

  <key>ProgramArguments</key>
  <array>
    <string>/bin/zsh</string>
    <string>/Users/mac/Downloads/stockai-main/scripts/run_stockai_web.sh</string>
  </array>

  <key>WorkingDirectory</key>
  <string>/Users/mac/Downloads/stockai-main</string>

  <key>RunAtLoad</key>
  <true/>

  <key>KeepAlive</key>
  <true/>

  <key>StandardOutPath</key>
  <string>/Users/mac/.stockai/logs/web.out.log</string>

  <key>StandardErrorPath</key>
  <string>/Users/mac/.stockai/logs/web.err.log</string>

  <key>ProcessType</key>
  <string>Background</string>
</dict>
</plist>
